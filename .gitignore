# ── Dependencies ─────────────────────────────────────────────
node_modules/
*/node_modules/
**/node_modules/
venv/

# ── Secrets (NEVER commit) ───────────────────────────────────
.env
.env.local
.env.production
server_side/backend/.env
client_side/frontend/.env.production
*.pem
*.key

# ── Build outputs ────────────────────────────────────────────
dist/
build/
client_side/frontend/dist/

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*

# ── Uploads (use Supabase Storage in production) ─────────────
server_side/backend/uploads/*
!server_side/backend/uploads/.gitkeep

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/
*.swp
*.swo
